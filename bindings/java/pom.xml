<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.murylloex</groupId>
  <artifactId>mini-waf</artifactId>
  <version>0.1.0</version>
  <name>mini-waf</name>
  <description>Java binding of mini-waf, a minimalistic Web Application Firewall engine (Foreign Function &amp; Memory API over libmini_waf).</description>
  <url>https://github.com/turrety/mini-waf-native</url>

  <licenses>
    <license>
      <name>MIT</name>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>22</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Directory holding libmini_waf for the tests. -->
    <mini-waf.library.dir>${project.basedir}/../../target/release</mini-waf.library.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <compilerArgs>
            <!-- FFM calls are "restricted" by design; enabled at run time. -->
            <arg>-Xlint:all,-restricted</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <argLine>--enable-native-access=ALL-UNNAMED -Dmini_waf.library.path=${mini-waf.library.dir}</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
